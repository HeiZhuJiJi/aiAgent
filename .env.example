POSTGRES_PASSWORD=
PROCUREMENT_DB_PASSWORD=
MINIO_ROOT_PASSWORD=
SECRET_MASTER_KEY=
REDIS_URL=redis://127.0.0.1:56379/0
ADMISSION_NAMESPACE=enterprise-agent:admission
ADMISSION_GLOBAL_TASKS=32
ADMISSION_WORKSPACE_TASKS=4
ADMISSION_MODEL_PROVIDER=8
ADMISSION_CAPABILITY=16
ADMISSION_MCP=8
ADMISSION_LEASE_MS=360000

MODEL_MODE=local
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_CONTAINER_BASE_URL=http://host.docker.internal:8000/v1
MODEL_NAME=Qwen/Qwen3.8-27B
MODEL_API_KEY=
EMBEDDING_MODE=local
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
# Leave blank to use the Compose-managed TEI service at http://embedding:80/v1.
# Set an OpenAI-compatible external URL here only when intentionally overriding it.
EMBEDDING_CONTAINER_BASE_URL=
EMBEDDING_NAME=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_SERVICE_MODEL_ID=BAAI/bge-m3
EMBEDDING_SERVICE_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_HEALTH_START_PERIOD=15m
KNOWLEDGE_EMBED_BATCH_SIZE=8
RERANKER_MODE=local
RERANKER_BASE_URL=http://127.0.0.1:8002/v1
RERANKER_CONTAINER_BASE_URL=http://host.docker.internal:8002/v1
RERANKER_NAME=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
KNOWLEDGE_RERANK_TIMEOUT_SEC=3
WEB_MODE=local
WEB_BASE_URL=http://127.0.0.1:8003/v1
WEB_CONTAINER_BASE_URL=http://host.docker.internal:8003/v1
WEB_API_KEY=

# Optional Grafana host port override (loopback only).
GRAFANA_HOST_PORT=53000

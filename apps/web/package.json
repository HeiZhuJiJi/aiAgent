    "@playwright/test": "1.55.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",

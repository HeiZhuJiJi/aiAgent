{
  "$defs": {
    "VersionRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "identifier": {
          "title": "Identifier",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "identifier",
        "version",
        "sha256"
      ],
      "title": "VersionRef",
      "type": "object"
    }
  },

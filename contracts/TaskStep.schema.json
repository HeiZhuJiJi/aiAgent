{
  "$defs": {
    "CapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "version_range": {
          "title": "Version Range",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version_range"
      ],
      "title": "CapabilityRequirement",
      "type": "object"
    },
    "PlanStepSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "step_key": {
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "capability_requirements": {
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          },
          "minItems": 1,
          "title": "Capability Requirements",
          "type": "array"
        },
        "expected_output": {
          "title": "Expected Output",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "risk_hint": {
          "$ref": "#/$defs/Risk"
        },
        "execution_mode": {
          "enum": [
            "CAPABILITY",
            "RESEARCH_SUBAGENT",
            "REVIEW"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "parallelizable": {
          "title": "Parallelizable",
          "type": "boolean"
        },
        "max_attempts": {
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "step_key",
        "objective",
        "capability_requirements",
        "expected_output",
        "success_criteria",
        "risk_hint",
        "execution_mode",
        "parallelizable",
        "max_attempts"
      ],
      "title": "PlanStepSpec",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL_SIDE_EFFECT"
      ],
      "title": "Risk",
      "type": "string"
    },
    "StepState": {
      "enum": [
        "PENDING",
        "READY",
        "RUNNING",
        "RETRY_WAIT",
        "WAITING_HITL",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "SKIPPED",
        "SUPERSEDED"
      ],
      "title": "StepState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "step_id": {
      "format": "uuid",
      "title": "Step Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/PlanStepSpec"
    },
    "state": {
      "$ref": "#/$defs/StepState"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "fencing_token": {
      "minimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    }
  },
  "required": [
    "step_id",
    "workspace_id",
    "task_id",
    "plan_id",
    "spec",
    "state",
    "version",
    "fencing_token"
  ],
  "title": "TaskStep",
  "type": "object"
}

{
  "$defs": {
    "CapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "version_range": {
          "title": "Version Range",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version_range"
      ],
      "title": "CapabilityRequirement",
      "type": "object"
    },
    "PlanStepSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "step_key": {
          "minLength": 1,
          "title": "Step Key",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "dependencies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "capability_requirements": {
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          },
          "minItems": 1,
          "title": "Capability Requirements",
          "type": "array"
        },
        "expected_output": {
          "title": "Expected Output",
          "type": "string"
        },
        "success_criteria": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Success Criteria",
          "type": "array"
        },
        "risk_hint": {
          "$ref": "#/$defs/Risk"
        },
        "execution_mode": {
          "enum": [
            "CAPABILITY",
            "RESEARCH_SUBAGENT",
            "REVIEW"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "parallelizable": {
          "title": "Parallelizable",
          "type": "boolean"
        },
        "max_attempts": {
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "required": [
        "step_key",
        "objective",
        "capability_requirements",
        "expected_output",
        "success_criteria",
        "risk_hint",
        "execution_mode",
        "parallelizable",
        "max_attempts"
      ],
      "title": "PlanStepSpec",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL_SIDE_EFFECT"
      ],
      "title": "Risk",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "trigger": {
      "enum": [
        "TERMINAL_FAILURE",
        "EVIDENCE_INSUFFICIENT",
        "CAPABILITY_UNAVAILABLE",
        "VALIDATION_FAILURE",
        "USER_MODIFICATION",
        "BUDGET_DANGER"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "action": {
      "enum": [
        "ADD_STEP",
        "REPLACE_STEP",
        "EXPAND_STEP",
        "RETRY_STEP",
        "SKIP_STEP",
        "ABORT_TASK"
      ],
      "title": "Action",
      "type": "string"
    },
    "affected_steps": {
      "items": {
        "type": "string"
      },
      "title": "Affected Steps",
      "type": "array"
    },
    "new_steps": {
      "items": {
        "$ref": "#/$defs/PlanStepSpec"
      },
      "title": "New Steps",
      "type": "array"
    },
    "preserve_completed_steps": {
      "title": "Preserve Completed Steps",
      "type": "boolean"
    },
    "budget_impact": {
      "minimum": 0,
      "title": "Budget Impact",
      "type": "number"
    }
  },
  "required": [
    "reason",
    "trigger",
    "action",
    "affected_steps",
    "new_steps",
    "preserve_completed_steps",
    "budget_impact"
  ],
  "title": "ReplanDecision",
  "type": "object"
}

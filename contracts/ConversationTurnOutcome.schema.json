{
  "$defs": {
    "ConversationTurnOutcomeStatus": {
      "enum": [
        "ANSWERED",
        "PARTIALLY_ANSWERED",
        "CLARIFICATION_REQUIRED",
        "UNAVAILABLE",
        "FAILED"
      ],
      "title": "ConversationTurnOutcomeStatus",
      "type": "string"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "safe_detail": {
          "title": "Safe Detail",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "safe_detail",
        "trace_id"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FailureCode": {
      "enum": [
        "LLM_RATE_LIMIT",
        "LLM_TIMEOUT",
        "LLM_SERVER_ERROR",
        "LLM_SCHEMA_ERROR",
        "CAPABILITY_TIMEOUT",
        "CAPABILITY_UNAVAILABLE",
        "CAPABILITY_BAD_OUTPUT",
        "CAPABILITY_UNKNOWN_OUTCOME",
        "MCP_DISCONNECTED",
        "MCP_SCHEMA_CHANGED",
        "DB_UNAVAILABLE",
        "WORKER_CRASH",
        "CONTEXT_OVERFLOW",
        "BUDGET_EXCEEDED",
        "POLICY_DENIED",
        "APPROVAL_REJECTED",
        "VALIDATION_FAILED",
        "STALE_ATTEMPT",
        "CONSISTENCY_VIOLATION"
      ],
      "title": "FailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "outcome_id": {
      "format": "uuid",
      "title": "Outcome Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ConversationTurnOutcomeStatus"
    },
    "assistant_message_id": {
      "format": "uuid",
      "title": "Assistant Message Id",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context_eligible": {
      "title": "Context Eligible",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "workspace_id",
    "turn_id",
    "attempt_id",
    "status",
    "assistant_message_id",
    "context_eligible",
    "created_at"
  ],
  "title": "ConversationTurnOutcome",
  "type": "object"
}

  "required": [
    "evidence_id",
    "workspace_id",
    "task_id",
    "step_id",
    "source_type",
    "source_id",
    "locator",
    "content",
    "content_hash",
    "source_hash",
    "source_version",
    "confidence",
    "relevance",
    "retrieved_at",
    "generated_by",
    "derived_from"

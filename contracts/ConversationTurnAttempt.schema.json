{
  "$defs": {
    "ConversationTurnAttemptState": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "SUPERSEDED"
      ],
      "title": "ConversationTurnAttemptState",
      "type": "string"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "safe_detail": {
          "title": "Safe Detail",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "safe_detail",
        "trace_id"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FailureCode": {
      "enum": [
        "LLM_RATE_LIMIT",
        "LLM_TIMEOUT",
        "LLM_SERVER_ERROR",
        "LLM_SCHEMA_ERROR",
        "CAPABILITY_TIMEOUT",
        "CAPABILITY_UNAVAILABLE",
        "CAPABILITY_BAD_OUTPUT",
        "CAPABILITY_UNKNOWN_OUTCOME",
        "MCP_DISCONNECTED",
        "MCP_SCHEMA_CHANGED",
        "DB_UNAVAILABLE",
        "WORKER_CRASH",
        "CONTEXT_OVERFLOW",
        "BUDGET_EXCEEDED",
        "POLICY_DENIED",
        "APPROVAL_REJECTED",
        "VALIDATION_FAILED",
        "STALE_ATTEMPT",
        "CONSISTENCY_VIOLATION"
      ],
      "title": "FailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ConversationTurnAttemptState"
    },
    "fencing_token": {
      "exclusiveMinimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    },
    "trace_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    }
  },
  "required": [
    "attempt_id",
    "workspace_id",
    "turn_id",
    "state",
    "fencing_token",
    "trace_id",
    "started_at"
  ],
  "title": "ConversationTurnAttempt",
  "type": "object"
}

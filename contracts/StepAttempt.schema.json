{
  "$defs": {
    "AttemptState": {
      "enum": [
        "CREATED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN",
        "CANCELLED"
      ],
      "title": "AttemptState",
      "type": "string"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "safe_detail": {
          "title": "Safe Detail",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "code",
        "safe_detail",
        "trace_id"
      ],
      "title": "Failure",
      "type": "object"
    },
    "FailureCode": {
      "enum": [
        "LLM_RATE_LIMIT",
        "LLM_TIMEOUT",
        "LLM_SERVER_ERROR",
        "LLM_SCHEMA_ERROR",
        "CAPABILITY_TIMEOUT",
        "CAPABILITY_UNAVAILABLE",
        "CAPABILITY_BAD_OUTPUT",
        "CAPABILITY_UNKNOWN_OUTCOME",
        "MCP_DISCONNECTED",
        "MCP_SCHEMA_CHANGED",
        "DB_UNAVAILABLE",
        "WORKER_CRASH",
        "CONTEXT_OVERFLOW",
        "BUDGET_EXCEEDED",
        "POLICY_DENIED",
        "APPROVAL_REJECTED",
        "VALIDATION_FAILED",
        "STALE_ATTEMPT",
        "CONSISTENCY_VIOLATION"
      ],
      "title": "FailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "step_id": {
      "format": "uuid",
      "title": "Step Id",
      "type": "string"
    },
    "worker_id": {
      "title": "Worker Id",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/AttemptState"
    },
    "fencing_token": {
      "exclusiveMinimum": 0,
      "title": "Fencing Token",
      "type": "integer"
    },
    "lease_expires_at": {
      "format": "date-time",
      "title": "Lease Expires At",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "workspace_id",
    "step_id",
    "worker_id",
    "state",
    "fencing_token",
    "lease_expires_at",
    "started_at",
    "trace_id"
  ],
  "title": "StepAttempt",
  "type": "object"
}

    },
    "expected_output": {
      "title": "Expected Output",
      "type": "string"
    },
    "success_criteria": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Success Criteria",
      "type": "array"
    },
    "risk_hint": {

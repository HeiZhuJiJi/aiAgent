{
  "$defs": {
    "CapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "version_range": {
          "title": "Version Range",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "version_range"
      ],
      "title": "CapabilityRequirement",
      "type": "object"
    },
    "Risk": {
      "enum": [
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL_SIDE_EFFECT"
      ],
      "title": "Risk",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "step_key": {
      "minLength": 1,
      "title": "Step Key",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "capability_requirements": {
      "items": {
        "$ref": "#/$defs/CapabilityRequirement"
      },

      "title": "Execution Mode",
      "type": "string"
    },
    "parallelizable": {
      "title": "Parallelizable",
      "type": "boolean"
    },
    "max_attempts": {
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    }

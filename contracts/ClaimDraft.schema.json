{
  "$defs": {
    "Risk": {
      "enum": [
        "READ",
        "WRITE",
        "EXECUTE",
        "EXTERNAL_SIDE_EFFECT"
      ],
      "title": "Risk",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "content": {
      "minLength": 1,
      "title": "Content",
      "type": "string"
    },
    "importance": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "title": "Importance",
      "type": "string"
    },
    "risk_level": {
      "$ref": "#/$defs/Risk"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "content",
    "importance",
    "risk_level",
    "evidence_ids"
  ],
  "title": "ClaimDraft",
  "type": "object"
}
